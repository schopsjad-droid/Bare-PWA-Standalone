rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { return request.auth != null; }
    function isAdmin() { return request.auth.token.email == 'schops.jad@gmail.com'; }

    // ========================================
    // Users Collection
    // ========================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        request.auth.uid == userId || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount'])
      );

      match /reviews/{reviewId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.reviewerId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ========================================
    // Ads Collection
    // ========================================
    match /ads/{adId} {
      // Validate location fields if present
      function validLocation() {
        let d = request.resource.data;
        return (
          (!('latitude' in d) || d.latitude == null || (d.latitude is number && d.latitude >= -90 && d.latitude <= 90)) &&
          (!('longitude' in d) || d.longitude == null || (d.longitude is number && d.longitude >= -180 && d.longitude <= 180)) &&
          (!('geohash' in d) || d.geohash == null || (d.geohash is string && d.geohash.size() > 0)) &&
          (!('locationPrecision' in d) || d.locationPrecision == null || d.locationPrecision in ['approximate', 'exact']) &&
          (!('listingStatus' in d) || d.listingStatus in ['available', 'reserved', 'sold'])
        );
      }

      allow read: if true;
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && validLocation();
      allow update: if isAuthenticated() && (
        // Owner can update all fields
        (request.auth.uid == resource.data.userId && validLocation()) ||
        // Anyone can increment views
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) ||
        // Owner can change listingStatus only
        (request.auth.uid == resource.data.userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['listingStatus']))
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
    }

    // ========================================
    // Chats Collection (Option B+ - Secure)
    // ========================================
    match /chats/{chatId} {
      // CREATE: Only if authenticated user is inside participants array
      allow create: if isAuthenticated() 
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      // READ (get + list): Only if authenticated user is inside participants array
      // For queries, Firestore validates that the query constraint guarantees
      // all returned documents satisfy this rule. Using array-contains in the
      // query satisfies this condition.
      allow read: if isAuthenticated() 
        && request.auth.uid in resource.data.participants;

      // UPDATE: Only for participants (e.g., updating lastMessage, updatedAt)
      allow update: if isAuthenticated() 
        && request.auth.uid in resource.data.participants;

      // DELETE: Admin only
      allow delete: if isAuthenticated() && isAdmin();

      // ========================================
      // Messages Sub-collection
      // ========================================
      match /messages/{messageId} {
        // CREATE: Only if authenticated user is a participant of the parent chat
        // and the senderId matches the authenticated user
        allow create: if isAuthenticated() 
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;

        // READ: Only for participants of the parent chat
        allow read: if isAuthenticated() 
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        // UPDATE/DELETE: Disabled
        allow update, delete: if false;
      }
    }

    // ========================================
    // Reports Collection
    // ========================================
    match /reports/{reportId} {
      allow read: if isAuthenticated() && isAdmin();
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if false;
    }

    // ========================================
    // Favorites Collection
    // ========================================
    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow update: if false;
    }

    // ========================================
    // Deny All Other Access
    // ========================================
    match /{document=**} { allow read, write: if false; }
  }
}
